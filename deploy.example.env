# Everything needed to rebuild this instance from nothing. Copy to `deploy.env`
# (gitignored) and fill in. `scripts/setup.sh` and `scripts/wire-workos.sh` read it.
#
# This repo is PUBLIC, so the real deploy.env is never committed — same split as
# r-drop's .dev.vars / .dev.vars.example.

# --- Cloudflare -------------------------------------------------------------
# Token needs: Workers Scripts Write, D1 Write, KV Write, R2 Write, Account Read
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- identity ---------------------------------------------------------------
# Claimed as the first superadmin by the bootstrap token. Always an admin.
SUPERADMIN_EMAIL=
# Optional extra admins, comma-separated. Admins bypass the invite gate.
ADMIN_EMAILS=

# --- WorkOS (optional) ------------------------------------------------------
# Unset both and login is bootstrap-only; the WorkOS routes 404. The API key's
# secret is shown once at creation and cannot be read back from the API.
# The environment must list this instance's redirect URI:
#   https://<app-url>/api/auth/callback
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# --- provisioned resources (recorded after the first setup.sh run) ----------
# Not secret, but losing them means a rebuild creates NEW empty ones rather than
# reattaching to your data.
WORKERS_SUBDOMAIN=
D1_DATABASE_ID=
KV_NAMESPACE_ID=
R2_BUCKET=glance-files

# --- write-only worker secrets ----------------------------------------------
# Generated by setup.sh, pushed to Cloudflare, and NOT readable back. Losing them
# is survivable: regenerating invalidates live sessions and share links, nothing
# stored. Record them here if you want a rebuild to preserve both.
SESSION_SECRET=
CONTENT_TOKEN_SECRET=
BOOTSTRAP_TOKEN=
