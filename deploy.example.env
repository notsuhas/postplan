# Everything needed to rebuild this instance. Copy to `deploy.env` (gitignored),
# fill it in, then run `scripts/setup.sh`.
#
# This repo is PUBLIC, so the real deploy.env is never committed — same split as
# r-drop's .dev.vars / .dev.vars.example.

# --- Cloudflare -------------------------------------------------------------
# Token needs: Workers Scripts Write, D1 Write, KV Write, R2 Write, Account Read
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- identity ---------------------------------------------------------------
# Claimed as the first superadmin by the bootstrap token. Always an admin.
SUPERADMIN_EMAIL=
# Optional extra superadmins, comma-separated. They bypass the invite gate and hold the
# `superadmin` role — users.role is `member | superadmin`, so there is no lesser admin tier.
SUPERADMIN_EMAILS=

# --- WorkOS (optional) ------------------------------------------------------
# Unset both and login is bootstrap-only; the WorkOS routes 404. The API key's
# secret is shown once at creation and cannot be read back from the API.
# The environment must list this instance's redirect URI:
#   https://<app-url>/api/auth/callback
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# --- hostnames -------------------------------------------------------------
# Two SEPARATE hostnames, not paths: the content origin exists so untrusted
# uploaded HTML/JS can never reach the app origin's session cookie. Both are
# Workers custom domains (wrangler owns the DNS record and cert), declared in
# each wrangler config's `routes` with custom_domain: true. Single-level names —
# Cloudflare Universal SSL does not cover a two-level wildcard.
APP_URL=
CONTENT_URL=

# --- names -----------------------------------------------------------------
WORKER_NAME=postplan
CONTENT_WORKER_NAME=postplan-content
D1_DATABASE_NAME=postplan-db

# --- provisioned resources --------------------------------------------------
# Paste the IDs returned by the provision commands in README.md.
WORKERS_SUBDOMAIN=
D1_DATABASE_ID=
KV_NAMESPACE_ID=
R2_BUCKET=postplan-files

# --- write-only worker secrets ----------------------------------------------
# Generated by setup.sh, pushed to Cloudflare, and NOT readable back. Losing them
# is survivable: regenerating invalidates live sessions and share links, nothing
# stored. Record them here if you want a rebuild to preserve both.
SESSION_SECRET=
CONTENT_TOKEN_SECRET=
BOOTSTRAP_TOKEN=
